# Copy to .env to override the local defaults in docker-compose.yml. Never commit .env.

# Database (local Postgres container)
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=desk
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=true
# Required outside local development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
API_PORT=8000

# Set by the hosting platform in deployed environments (not used locally):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PORT=8000
# WEB_CONCURRENCY=3
# RUN_MIGRATIONS=true

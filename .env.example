# Copy to .env to override the local defaults in docker-compose.yml. Never commit .env.

# Database (local Postgres container)
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=desk
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=true
# Required outside local development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-only-not-a-secret
# Signs login tokens. Separate from DJANGO_SECRET_KEY so it can be rotated (logging everyone out) on its own.
# Required; use a different random value per environment, at least 32 characters.
JWT_SIGNING_KEY=local-dev-only-jwt-signing-key-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
API_PORT=8000
# Notification email. Console backend locally (emails show in the logs); SMTP when deployed.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Dataset Request Desk <desk@example.com>
# Links in emails.
# FRONTEND_URL=https://desk.example.com
# Error reporting. Leave empty to disable (the local default).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=dev
# RELEASE=<git sha>
# HTTPS redirect, HSTS and secure cookies. Defaults to on unless DJANGO_DEBUG is true.
# HTTPS_ONLY=true
# Number of proxies in front of the API (e.g. 1 behind a load balancer), so throttling sees the real client IP.
TRUSTED_PROXY_COUNT=0
# Swagger UI at /api/docs/. Defaults to DJANGO_DEBUG; keep off in production.
API_DOCS_ENABLED=true
# Secure flag on the refresh cookie. Browsers accept it on http://localhost, so leave it on.
AUTH_COOKIE_SECURE=true
# Create the demo accounts from backend/seed/users.json on start. Never enable in production.
SEED_DEMO_DATA=true
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set by the hosting platform in deployed environments (not used locally):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PORT=8000
# WEB_CONCURRENCY=3
# RUN_MIGRATIONS=true

# Time zone for "today" in business rules (deadlines, deadline warnings). Timestamps stay in UTC.
# BUSINESS_TIME_ZONE=Africa/Kigali
